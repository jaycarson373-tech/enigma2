NEXT_PUBLIC_ENIGMA_NETWORK=mainnet-beta
NEXT_PUBLIC_SITE_URL=http://localhost:3143
# Optional private provider credential, server side only. Public RPC works for reads.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# No user private keys are required. Every write is reviewed/signed in the wallet.
# Block keeps this compatibility flag off until finalized deployment and funded acceptance verify.
ENIGMA_WRITES_ENABLED=false

# Server only, supplied automatically by a linked Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional public profile; legacy IPO_X_URL, OPENBELL_X_URL and ENIGMA_X_URL remain supported.
BLOCK_X_URL=
